# Copie este arquivo para ".env" e preencha com os valores reais (nunca commitar o .env de verdade)

# String de conexao do MySQL (Prisma). Em dev local aponta pro container do docker-compose.
# Em producao, aponta para o banco hospedado separadamente (gerenciado pelo colega do banco).
DATABASE_URL="mysql://root:root@localhost:3306/requisitos_game"

# Chave da API do Gemini, usada para gerar novos requisitos sob demanda.
GEMINI_API_KEY=""

# Porta em que o servidor Express vai escutar.
PORT=3000

# Segredo usado para assinar/verificar o JWT emitido em POST /auth/login.
# O login nao usa senha (RF01) — o JWT so confirma a identidade encontrada/criada,
# nunca commitar o valor real usado em produção.
JWT_SECRET="troque-por-um-segredo-aleatorio-longo"

# Por quanto tempo o token de login fica valido (ver formatos aceitos em
# https://github.com/vercel/ms). Sem senha/refresh-token, um valor longo evita
# pedir login de novo com frequencia incomoda.
JWT_EXPIRES_IN="30d"

# Origem(ns) do frontend liberadas no CORS (separe por virgula se precisar de mais de uma).
FRONTEND_URL="http://localhost:5173"

# Tamanho maximo (em bytes) de cada imagem enviada no cadastro de mundo (icone/fundo).
TEMA_IMAGEM_MAX_BYTES=2097152
